{
  "_comment": "The search syntax, as SearchQuery.kt and debugParseSearch in shared.js both parse it. Each case gives the parsed terms in one line: groups joined by AND, a group of more than one term in parentheses with OR, and a term as [-][field:]\"text\" or [-][field:]/regex/. fields false parses as a WebSocket message search does. An error case must fail to parse in both.",
  "parse": [
    { "query": "featured", "terms": "\"featured\"" },
    { "query": "featured | popular", "terms": "(\"featured\" OR \"popular\")" },
    { "query": "featured OR popular", "terms": "(\"featured\" OR \"popular\")" },
    { "query": "featured|popular", "terms": "(\"featured\" OR \"popular\")" },
    { "query": "lists json", "terms": "\"lists\" AND \"json\"" },
    { "query": "lists AND json", "terms": "\"lists\" AND \"json\"" },
    { "query": "  lists\tjson  ", "terms": "\"lists\" AND \"json\"" },
    { "query": "pocketcasts -analytics", "terms": "\"pocketcasts\" AND -\"analytics\"" },
    { "query": "-analytics", "terms": "-\"analytics\"" },
    { "query": "NOT analytics", "terms": "-\"analytics\"" },
    { "query": "NOT -analytics", "terms": "-\"analytics\"" },
    { "query": "a b | c", "terms": "\"a\" AND (\"b\" OR \"c\")" },
    { "query": "a | b c | d", "terms": "(\"a\" OR \"b\") AND (\"c\" OR \"d\")" },
    { "query": "a | -b", "terms": "(\"a\" OR -\"b\")" },
    { "query": "a OR OR b", "terms": "(\"a\" OR \"b\")" },
    { "query": "| a", "terms": "\"a\"" },
    { "query": "OR a", "terms": "\"a\"" },
    { "query": "a |", "terms": "\"a\"" },
    { "query": "a OR", "terms": "\"a\"" },
    { "query": "a NOT", "terms": "\"a\"" },
    { "query": "NOT | a", "terms": "\"a\"" },
    { "query": "OR", "terms": "" },
    { "query": "|", "terms": "" },
    { "query": "Or ORder", "terms": "\"Or\" AND \"ORder\"" },
    { "query": "-", "terms": "\"-\"" },
    { "query": "- a", "terms": "\"-\" AND \"a\"" },
    { "query": "a-b", "terms": "\"a-b\"" },
    { "query": "\"podcast list\"", "terms": "\"podcast list\"" },
    { "query": "\"podcast_list\"", "terms": "\"podcast_list\"" },
    { "query": "-\"podcast list\" x", "terms": "-\"podcast list\" AND \"x\"" },
    { "query": "\"a b\"|c", "terms": "(\"a b\" OR \"c\")" },
    { "query": "\"say \\\"hi\\\"\"", "terms": "\"say \\\"hi\\\"\"" },
    { "query": "\"unterminated phrase", "terms": "\"unterminated phrase\"" },
    { "query": "\"id\":42", "terms": "\"\\\"id\\\":42\"" },
    { "query": "\"id\": 42", "terms": "\"\\\"id\\\":\" AND \"42\"" },
    { "query": "\"\"", "terms": "\"\\\"\\\"\"" },
    { "query": "\"", "terms": "\"\\\"\"" },
    { "query": "/featured-\\d+\\.json/", "terms": "/featured-\\d+\\.json/" },
    { "query": "/a|b/", "terms": "/a|b/" },
    { "query": "a|/b/", "terms": "(\"a\" OR /b/)" },
    { "query": "/a/|b", "terms": "(/a/ OR \"b\")" },
    { "query": "/^order paid/ x", "terms": "/^order paid/ AND \"x\"" },
    { "query": "/users and /posts", "terms": "\"/users\" AND \"and\" AND \"/posts\"" },
    { "query": "/users /posts/", "terms": "\"/users\" AND /posts/" },
    { "query": "/api/", "terms": "/api/" },
    { "query": "/api/v1/", "terms": "\"/api/v1/\"" },
    { "query": "/api/v1/users", "terms": "\"/api/v1/users\"" },
    { "query": "/a\\/b/", "terms": "/a\\/b/" },
    { "query": "/a\\/", "terms": "\"/a\\\\/\"" },
    { "query": "//", "terms": "\"//\"" },
    { "query": "/", "terms": "\"/\"" },
    { "query": "regex:featured-\\d+", "terms": "/featured-\\d+/" },
    { "query": "REGEX:a|b", "terms": "/a|b/" },
    { "query": "regex:\"a b\" c", "terms": "/a b/ AND \"c\"" },
    { "query": "regex:", "terms": "\"regex:\"" },
    { "query": "url:feed method:get status:4xx header:no-cache body:token", "terms": "url:\"feed\" AND method:\"get\" AND status:\"4xx\" AND header:\"no-cache\" AND body:\"token\"" },
    { "query": "URL:Feed Status:5XX", "terms": "url:\"Feed\" AND status:\"5XX\"" },
    { "query": "status:404 status:\"200\"", "terms": "status:\"404\" AND status:\"200\"" },
    { "query": "status:/^5/", "terms": "status:/^5/" },
    { "query": "-url:/v\\d+/", "terms": "-url:/v\\d+/" },
    { "query": "url:regex:^https", "terms": "url:/^https/" },
    { "query": "url:\"a b\"", "terms": "url:\"a b\"" },
    { "query": "header:\"cache-control: no\"", "terms": "header:\"cache-control: no\"" },
    { "query": "url:/api/v1/", "terms": "url:\"/api/v1/\"" },
    { "query": "url:", "terms": "\"url:\"" },
    { "query": "url: x", "terms": "\"url:\" AND \"x\"" },
    { "query": "cache-control:no-cache", "terms": "\"cache-control:no-cache\"" },
    { "query": "x:y", "terms": "\"x:y\"" },
    { "query": "\"status:ok\"", "terms": "\"status:ok\"" },
    { "query": "url:foo", "fields": false, "terms": "\"url:foo\"" },
    { "query": "status:ok -body:x", "fields": false, "terms": "\"status:ok\" AND -\"body:x\"" },
    { "query": "regex:^ping /po+ng/", "fields": false, "terms": "/^ping/ AND /po+ng/" }
  ],
  "errors": [
    "status:ok",
    "status:4040",
    "status:\"not found\"",
    "-status:abc",
    "a | status:1"
  ]
}
