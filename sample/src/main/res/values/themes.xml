<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Targeting API 35 makes the status bar transparent over the light action bar,
        where the platform's default white status bar icons are invisible, so ask for
        dark ones. Below API 35 the status bar keeps its own color: match it to the
        action bar so both look the same.
    -->
    <style name="Theme.LustroSample" parent="@android:style/Theme.Material.Light">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">?android:attr/colorPrimary</item>
    </style>
</resources>
